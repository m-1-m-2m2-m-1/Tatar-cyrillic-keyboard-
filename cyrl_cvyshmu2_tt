    key <AD05> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U043C, U041C ] };
    key <AD06> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0443, U0423, w, W ] };
    key <AD07> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U043A, U041A, U049B, U049A ] };
    key <AD08> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0434, U0414 ] };
    key <AD09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U04AF, U04AE ] };
    key <AD10> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U043F, U041F ] };
    key <AD11> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0445, U0425 ] };
    key <AD12> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U044C, U042C ] };

    // Original row 2
    key <AC01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0447, U0427, U0446, U0426 ] };
    key <AC02> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U04D9, U04D8 ] };
    key <AC03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0442, U0422 ] };
    key <AC04> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U043B, U041B ] };
