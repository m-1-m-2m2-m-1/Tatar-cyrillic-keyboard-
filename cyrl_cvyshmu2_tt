    key <AC10> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U043D, U041D, semicolon, colon ] };
    key <AC11> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0438, U0418, apostrophe, quotedbl ] };

    // Original row 3
    key <AB01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U044F, U042F, U044A, U042A ] };
