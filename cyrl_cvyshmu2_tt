// Tatar Cyrillic keyboard "cvyshmu2" (from Unexpected Keyboard: cyrl_cvyshmu2_tt)
// converted to an XKB symbols file for GNU/Linux.
//
// Levels: 1 = base, 2 = Shift, 3 = AltGr, 4 = AltGr+Shift.
// The original top-row swipes (digits and punctuation) live on the physical
// number row; swipe letters (ж ю щ қ w ц ё ъ ґ) are on AltGr.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "pc(pc105)"
    include "level3(ralt_switch)"

    name[Group1] = "Tatar (cvyshmu2)";

    // Physical number row: digits and punctuation from the original top row
    key <TLDE> { type[Group1] = "TWO_LEVEL", [ grave, asciitilde ] };
    key <AE01> { type[Group1] = "TWO_LEVEL", [ 1, exclam ] };
    key <AE02> { type[Group1] = "TWO_LEVEL", [ 2, at ] };
    key <AE03> { type[Group1] = "TWO_LEVEL", [ 3, numbersign ] };
    key <AE04> { type[Group1] = "TWO_LEVEL", [ 4, dollar ] };
    key <AE05> { type[Group1] = "TWO_LEVEL", [ 5, percent ] };
    key <AE06> { type[Group1] = "TWO_LEVEL", [ 6, asciicircum ] };
    key <AE07> { type[Group1] = "TWO_LEVEL", [ 7, ampersand ] };
    key <AE08> { type[Group1] = "TWO_LEVEL", [ 8, asterisk ] };
    key <AE09> { type[Group1] = "TWO_LEVEL", [ 9, parenleft ] };
    key <AE10> { type[Group1] = "TWO_LEVEL", [ 0, parenright ] };
    key <AE11> { type[Group1] = "FOUR_LEVEL", [ minus, underscore, bracketleft, braceleft ] };
    key <AE12> { type[Group1] = "FOUR_LEVEL", [ equal, plus, bracketright, braceright ] };
    key <BKSL> { type[Group1] = "TWO_LEVEL", [ backslash, bar ] };

    // Original row 1
    key <AD01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U04B7, U04B6, U0436, U0416 ] };
    key <AD02> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0432, U0412, U044E, U042E ] };
    key <AD03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ U0439, U0419 ] };
